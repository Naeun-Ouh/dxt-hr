# Supabase project with Google OAuth enabled. Never use a service-role key as the publishable key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Exact deployed origin; register /auth/callback in Supabase's redirect allowlist.
APP_ORIGIN=http://localhost:3000
# Server-only AES-256 keys. JSON object: key ID -> base64-encoded random 32-byte key.
# Generate each key with: openssl rand -base64 32
# Never prefix these variables with NEXT_PUBLIC_ or commit actual keys.
HR_ENCRYPTION_ACTIVE_KEY=
HR_ENCRYPTION_KEYS=

# Separate server-only vault AES-256 keyring; same JSON format as HR keys.
VAULT_ENCRYPTION_ACTIVE_KEY=
VAULT_ENCRYPTION_KEYS=

# Server-only private document proxy. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Google login uses Supabase Auth above. No Gmail delivery or cron credentials are required.
